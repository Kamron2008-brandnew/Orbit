{
  "name": "orbit",
  "version": "4.0.0",
  "private": true,
  "description": "Orbit: scan real objects into 3D with a phone camera. A web capture app plus a photogrammetry pipeline.",
  "type": "module",
  "scripts": {
    "lint": "eslint web-capture/js tests",
    "test": "node --test tests/*.test.js",
    "serve": "python3 -m http.server 8790 --directory web-capture",
    "format": "prettier --write \"web-capture/js/**/*.js\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
